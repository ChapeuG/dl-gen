# Versoes baseline do padrao heavy-transformation (Spark 3.5 + Delta 3.3)
[project]
name = "{{ dataset }}-transformation"
version = "1.0.0"
requires-python = ">=3.10"
dependencies = [
    "delta-spark==3.3.0",  # traz o pyspark 3.5.x; no cluster o Spark ja vem instalado
    "boto3>=1.34",
]

[project.optional-dependencies]
dev = ["pyspark==3.5.6", "pytest>=8.0"]

[build-system]
requires = ["setuptools>=68.0"]
build-backend = "setuptools.build_meta"

[tool.setuptools.packages.find]
include = ["datalake*"]
