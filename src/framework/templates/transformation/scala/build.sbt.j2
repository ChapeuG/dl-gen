// Versoes baseline do padrao heavy-transformation (skill project-structure)
val sparkVersion = "3.5.6"
val deltaVersion = "3.3.0"
val awsSdkVersion = "1.12.780"

val majorVersion = "1" //breaks binary compatibility
val minorVersion = "0" //breaks source compatibility
val patchVersion = "0" //No breaks

name := "{{ dataset }}-transformation"
version := s"$majorVersion.$minorVersion.$patchVersion"
scalaVersion := "2.12.20"
organization := "br.com.datalake"

libraryDependencies ++= Seq(
  "org.apache.spark" %% "spark-core" % sparkVersion % "provided",
  "org.apache.spark" %% "spark-sql" % sparkVersion % "provided",
  "org.apache.spark" %% "spark-hive" % sparkVersion % "provided",
  "io.delta" %% "delta-spark" % deltaVersion % "provided",
  "com.amazonaws" % "aws-java-sdk-secretsmanager" % awsSdkVersion % "provided",
  "com.amazonaws" % "aws-java-sdk-sqs" % awsSdkVersion % "provided"
)

artifactName := { (sv: ScalaVersion, module: ModuleID, artifact: Artifact) =>
  module.name + "." + artifact.extension
}

assembly / assemblyJarName := "{{ dataset }}.jar"

assembly / assemblyMergeStrategy := {
  case PathList("META-INF", xs@_*) => MergeStrategy.discard
  case x => MergeStrategy.first
}
assembly / assemblyOption ~= { _.withIncludeScala(false) }
